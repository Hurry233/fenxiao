    "bcryptjs": "^2.4.3",
    "dotenv": "^16.3.1",
    "cors": "^2.8.5",
    "helmet": "^7.0.0",
    "express-rate-limit": "^6.10.0",
    "qrcode": "^1.5.3",
    "multer": "^1.4.5-lts.1",
    "express-validator": "^7.0.1",
    "compression": "^1.7.4",
    "crypto": "^1.0.1"
