# FastGPT Configuration
# Copy this file to .env and fill in your actual API keys

# FastGPT Admin Key - used for creating datasets and uploading files
FASTGPT_ADMIN_KEY=your_fastgpt_admin_key_here

# FastGPT Chat App Key - used for chat functionality  
FASTGPT_CHAT_APP_KEY=your_fastgpt_chat_app_key_here

# FastGPT Base URL (default: https://fastgpt.aiown.top)
FASTGPT_BASE_URL=https://fastgpt.aiown.top

# JWT Secret Key (change this for production!)
JWT_SECRET=your-jwt-secret-key-change-this-for-production